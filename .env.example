# Shared
NGINX_PORT=80
SPRING_PROFILES_ACTIVE=docker

# Root Docker Compose service-to-service URLs
AGENT_BACKEND_URL=http://sysmind-agent:4000
AGENT_MCP_BACKEND_URL=http://sysmind-mcp:8080
AGENT_MCP_ENDPOINT=/mcp
MCP_CHROMA_URL=http://chroma:8000

# Agent runtime
AGENT_PORT=4000
AGENT_LM_STUDIO_BASE_URL=http://host.docker.internal:1234
AGENT_LM_STUDIO_API_KEY=lm-studio
AGENT_LM_STUDIO_MODEL=local-model
TOOL_TIMEOUT=10s
AGENT_TIMEOUT=60s
MAX_TOOL_CALLS_PER_USER_REQUEST=3

# MCP backend runtime
CHROMA_TIMEOUT=5s
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=sysmind
NEWS_LANGUAGE=en-US
NEWS_COUNTRY=US
NEWS_CEID=

# Local non-Docker defaults for manually running services
LOCAL_AGENT_BACKEND_URL=http://localhost:4000
LOCAL_MCP_BACKEND_URL=http://localhost:8080
LOCAL_MCP_ENDPOINT=/mcp
LOCAL_CHROMA_URL=http://localhost:8000
LOCAL_LM_STUDIO_BASE_URL=http://localhost:1234
